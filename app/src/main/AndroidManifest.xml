<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <queries>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.HOME" /></intent>
        <intent><action android:name="android.intent.action.DIAL" /></intent>
    </queries>
    <application android:allowBackup="false" android:fullBackupContent="false"
        android:label="قفل الكود الأول" android:icon="@drawable/ic_lock"
        android:supportsRtl="true" android:theme="@style/AppTheme" android:enableOnBackInvokedCallback="false"
        android:usesCleartextTraffic="false">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <activity android:name=".GateActivity" android:exported="false"
            android:launchMode="singleTask" android:taskAffinity="sa.firstcode.lock.guard"
            android:excludeFromRecents="true" android:theme="@style/AppTheme" />
        <service android:name=".LockService" android:exported="true"
            android:label="قفل الكود الأول"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility" />
        </service>
    </application>
</manifest>
